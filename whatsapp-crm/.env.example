# ================================================
# WhatsApp CRM - Environment Configuration
# ================================================

# ------------------------------------------------
# NABDA OTP API (WhatsApp Gateway)
# Get these from your Nabda OTP Dashboard
# ------------------------------------------------
NABDA_BASE_URL=https://api.nabdaotp.com/inst/YOUR_INSTANCE_ID
NABDA_TOKEN=YOUR_NABDA_SECRET_TOKEN

# ------------------------------------------------
# SUPABASE DATABASE
# Get these from your Supabase Project Settings > API
# ------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------
# WEBHOOK SERVER (for local development)
# ------------------------------------------------
WEBHOOK_PORT=3001

# ------------------------------------------------
# FRONTEND ENV VARS (for apps/web/.env)
# Copy these to apps/web/.env with VITE_ prefix:
# VITE_SUPABASE_URL=$SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
# ------------------------------------------------

# ------------------------------------------------
# OPTIONAL: CAMPAIGN DEFAULTS
# ------------------------------------------------
# DEFAULT_STRATEGY=A
# DEFAULT_DELAY=20
# DEFAULT_BATCH_SIZE=20
